<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Brain Drain</title>
  <link rel="shortcut icon" href="favicon.ico">
  <link rel="stylesheet" href="font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <section class="header">
    <h1>🧠 BRAIN DRAIN</h1>
    <h2>Your Mind, No Filter.</h2>
    <h2>Release your thoughts and free up some space.</h2>
  </section>

  <!--CREATE FORM-->
  <section class="form-section"> 
    <h3>What's on your mind?</h3> 
      <form action="/thoughts" method="POST">

  <!--DATE INPUT-->
        <div class="input-group">
          <label for="date">Date:</label>
          <input type="date" id="date" name="date" required> 

          <div class="input-group"> 
            <textarea name="thought" placeholder="What's on your mind today?" rows="4" required></textarea>
          </div>

    <!--FEELINGS-->
          <label>How are you feeling?</label>
            <div class="feelings-box">
              <label class="feeling-select"> 
                        <input type="radio" name="feeling" value="🤯 Overwhelmed" checked>
                        <span class="select-desc">🤯 Overwhelmed</span>
                    </label>
                    <label class="feeling-select">
                        <input type="radio" name="feeling" value="💡 Inspired">
                        <span class="select-desc">💡 Inspired</span>
                    </label>
                    <label class="feeling-select">
                        <input type="radio" name="feeling" value="😴 Tired">
                        <span class="select-desc">😴 Tired</span>
                    </label>
                    <label class="feeling-select">
                        <input type="radio" name="feeling" value="😊 Content">
                        <span class="select-desc">😊 Content</span>
                    </label>
                    <label class="feeling-select">
                        <input type="radio" name="feeling" value="🔥 Motivated">
                        <span class="select-desc">🔥 Motivated</span>
                    </label>
                    <label class="feeling-select">
                        <input type="radio" name="feeling" value="😐 Nuetral">
                        <span class="select-desc">😐 Nuetral</span>
                    </label>
                </div>
                <button type="submit" class="submit-button">Release Thought</button>
              </form> 
  </section>

  <section class="brain-drain-">
    <h3>Brain Drain</h3> 
    <ul class="thoughts-list"> 
      <% for (var i=0; i < thoughts.length; i++) {%>
        <li class="thought-box" data-id="<%=thoughts[i]._id %>">
          <div class="thought-header"> 
            <div class="thought-date">
              <strong>Date:</strong> 
            <span><%= thoughts[i].date %></span>
            </div>

            <div class="thought-feeling">
              <strong>Feeling:</strong>
            <span class="feeling-select"><%= thoughts[i].feeling %></span>
          </div>

          <div class="thought-content">
            <strong>Thought:</strong>
            <p><%= thoughts[i].thought %></p>
          </div>
        </li>
      <% } %> 
    </ul>
  </section>


  <script src="main.js"></script>

</body>
</html> 
